{
  "schema": "meta-reseek/p1c-eval",
  "version": 1,
  "frozen_at": "2026-10-24",
  "protocol": "冻结协议：本文件先行声明任务、脚本与预期停止条件并提交，评测脚本只读取本文件；预期为 CANDIDATE（对 mock 类按 P0 规则确定性推演，对回放类基于既往运行记录），不得由运行结果回填。",
  "classes": {
    "mock": "构造的确定性场景（脚本化 Provider，离线可精确重算）",
    "cache-replay": "真实搜索任务的离线缓存回放（依赖本机 artifacts/cache，缺失时该任务标记 skipped-no-cache，不参与汇总）"
  },
  "conditions_covered": [
    "sufficient_evidence", "strategy_adjustment", "diminishing_returns",
    "forced_max_rounds", "provider_final_failure", "provider_retry_recovered",
    "duplicate_and_pseudo_evidence", "key_condition_missing_high_coverage",
    "cross_domain_collision"
  ],
  "scenarios": [
    {
      "id": "M1-sufficient-easy",
      "class": "mock", "conditions": ["sufficient_evidence"],
      "purpose": "证据充分，首轮命中后正常停止",
      "task": {
        "name": "M1", "question": "Q?", "seed_query": "seed query one",
        "min_relevant_per_subq": 2, "max_rounds": 5,
        "sub_questions": [
          {"id": "a", "text": "alpha topic question about widgets", "keywords": ["widgets", "alpha"], "alt_queries": []},
          {"id": "b", "text": "beta topic question about gadgets", "keywords": ["gadgets", "beta"], "alt_queries": []}
        ]
      },
      "script": [
        {"match": "*", "hits": [
          {"title": "Widgets alpha explained", "url": "https://a1.example.com/w", "snippet": "All about widgets and alpha facts in depth."},
          {"title": "Alpha widgets guide", "url": "https://a2.example.com/w", "snippet": "Widgets alpha reference with details."},
          {"title": "Gadgets beta overview", "url": "https://b1.example.com/g", "snippet": "Gadgets and beta overview in depth."},
          {"title": "Beta gadgets handbook", "url": "https://b2.example.com/g", "snippet": "Beta gadgets handbook covering everything."}
        ], "final_error": false, "retries": 0}
      ],
      "expected_stop": "stop_sufficient", "expected_rounds": 1,
      "expected_channel_error_rounds": 0, "expected_retries_total": 0
    },
    {
